# Local Docker deployment env — separate from .env (used by `npm run dev`
# against the host-network Postgres on :5433) because the values that are
# correct for a container are different: DB_PASSWORD instead of a full
# DATABASE_URL (compose.prod.yaml builds that itself), and
# host.docker.internal instead of localhost to reach Ollama running on the
# host machine from inside the container.

DB_PASSWORD=roomtone-docker-local
AUTH_SECRET=f4a6b075e184f01f5fab5787082116f6eeadaef55c039a0e36f8bb2ccf4c1a35
PUBLIC_BASE_URL=http://localhost:3000

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

REALTIME_ADAPTER=memory
