DATABASE_URL="postgresql://roomtone:roomtone@localhost:5433/roomtone?schema=public"

# Signing key for the presenter session JWT. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-char-hex-string"

# Base URL used to build the participant join link embedded in the QR code.
PUBLIC_BASE_URL="http://localhost:3000"

# Optional AI layer. "none" | "ollama" | "openrouter"
AI_PROVIDER="none"
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_CHAT_MODEL="qwen2.5-coder:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="meta-llama/llama-3.1-8b-instruct:free"
