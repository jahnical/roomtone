# Copy to .env before running: docker compose -f compose.prod.yaml up -d --build
# (docker compose reads .env from the same directory automatically.)

# Required — a strong random password for the production Postgres instance.
DB_PASSWORD=

# Required — session-signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Required — your real domain, used to build the QR/join URL participants
# scan. Must match wherever this is actually reachable from a phone.
PUBLIC_BASE_URL=https://roomtone.example.com

# Optional AI layer. "none" (default) | "ollama" | "openrouter"
AI_PROVIDER=none

# Only used when AI_PROVIDER=ollama. Defaults assume Ollama is running on
# the Docker host itself (see compose.prod.yaml's extra_hosts entry).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Only used when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.1-8b-instruct:free

# "memory" (default) is correct for this single-container compose file.
# Only set to "postgres" if you're running more than one app container
# behind a load balancer — see lib/realtime/postgres-hub.ts.
REALTIME_ADAPTER=memory
